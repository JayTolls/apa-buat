    def extract_parameters(self):
        """Extract all parameters from URL and forms"""
        print("[*] Extracting parameters...")
        
        parameters = []
        
        # Extract from URL
        parsed = urlparse(self.target_url)
        if parsed.query:
            params = parse_qs(parsed.query)
            for key in params.keys():
                parameters.append({
                    'name': key,
                    'value': params[key][0] if params[key] else '',
                    'location': 'url',
                    'method': 'GET'
                })
        
        # Extract from forms
        try:
            resp = self.session.get(self.target_url, headers=self.get_random_headers(), timeout=self.timeout)
            
            # Find all forms
            forms = re.findall(r'<form[^>]*>(.*?)</form>', resp.text, re.DOTALL)
            
            for form in forms:
                action_match = re.search(r'action=["\']([^"\']*)["\']', form)
                method_match = re.search(r'method=["\']([^"\']*)["\']', form)
                
                action = action_match.group(1) if action_match else ''
                method = method_match.group(1).upper() if method_match else 'GET'
                
                # Extract inputs
                inputs = re.findall(r'<input[^>]*name=["\']([^"\']*)["\'][^>]*>', form)
                for input_name in inputs:
                    parameters.append({
                        'name': input_name,
                        'value': '',
                        'location': 'form',
                        'method': method,
                        'action': action
                    })
        except:
            pass
        
        self.results['parameters'] = parameters
        print(f"[+] Found {len(parameters)} parameters")
        return parameters
    
    def test_vulnerability(self, param, payload_type, payload):
        """Test vulnerability with AI analysis"""
        param_name = param['name']
        param_location = param['location']
        param_method = param['method']
        
        test_params = {param_name: payload}
        
        try:
            if param_location == 'url' or param_method == 'GET':
                parsed = urlparse(self.target_url)
                query_params = parse_qs(parsed.query)
                query_params[param_name] = payload
                new_query = urlencode(query_params, doseq=True)
                test_url = urljoin(self.target_url, parsed.path + '?' + new_query)
                
                start_time = time.time()
                resp = self.session.get(test_url, headers=self.get_random_headers(), timeout=self.timeout)
                response_time = time.time() - start_time
                
            else:
                test_data = {param_name: payload}
                start_time = time.time()
                resp = self.session.post(self.target_url, data=test_data, headers=self.get_random_headers(), timeout=self.timeout)
                response_time = time.time() - start_time
            
            # AI Analysis
            ai_findings = self.ai_detector.analyze_response(resp.text, payload_type)
            
            vulnerability = {
                'parameter': param_name,
                'payload': payload,
                'payload_type': payload_type,
                'location': param_location,
                'method': param_method,
                'status_code': resp.status_code,
                'response_time': response_time,
                'ai_findings': ai_findings,
                'response_length': len(resp.text)
            }
            
            return vulnerability
            
        except Exception as e:
            return {
                'parameter': param_name,
                'payload': payload,
                'payload_type': payload_type,
                'location': param_location,
                'method': param_method,
                'error': str(e)
            }
    
    def scan_vulnerabilities(self):
        """Scan for all vulnerabilities using AI"""
        print("[*] Scanning for vulnerabilities with AI...")
        
        params = self.extract_parameters()
        if not params:
            print("[!] No parameters found to scan")
            return
        
        vulnerabilities = []
        total_tests = 0
        
        # Prepare test queue
        test_queue = []
        for param in params:
            for payload_type, payloads in self.payloads.items():
                for payload in payloads[:self.max_payloads]:
                    test_queue.append((param, payload_type, payload))
                    total_tests += 1
        
        print(f"[*] Total tests to run: {total_tests}")
        
        # Run tests with threading
        with ThreadPoolExecutor(max_workers=self.threads) as executor:
            futures = []
            for param, payload_type, payload in test_queue:
                future = executor.submit(self.test_vulnerability, param, payload_type, payload)
                futures.append(future)
            
            completed = 0
            for future in as_completed(futures):
                try:
                    result = future.result(timeout=self.timeout + 5)
                    
                    # Check if vulnerability found
                    if 'ai_findings' in result and result['ai_findings']:
                        vulnerabilities.append(result)
                        self.print_vulnerability_found(result)
                    
                    completed += 1
                    if completed % 100 == 0:
                        print(f"[*] Progress: {completed}/{total_tests}")
                        
                except Exception as e:
                    pass
        
        self.results['vulnerabilities'] = vulnerabilities
        print(f"[+] Found {len(vulnerabilities)} vulnerabilities")
        
        return vulnerabilities
    
