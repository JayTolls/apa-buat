    def analyze_ssl(self):
        """Analyze SSL/TLS"""
        print("[*] Analyzing SSL/TLS...")
        
        try:
            parsed = urlparse(self.target_url)
            hostname = parsed.netloc.split(':')[0]
            port = 443
            
            context = ssl.create_default_context()
            context.check_hostname = False
            context.verify_mode = ssl.CERT_NONE
            
            with socket.create_connection((hostname, port), timeout=self.timeout) as sock:
                with context.wrap_socket(sock, server_hostname=hostname) as ssock:
                    cert = ssock.getpeercert()
                    self.results['ssl_info']['version'] = ssock.version()
                    self.results['ssl_info']['cipher'] = ssock.cipher()
                    self.results['ssl_info']['certificate'] = cert
                    
                    print(f"[+] SSL/TLS Version: {ssock.version()}")
                    print(f"[+] Cipher: {ssock.cipher()}")
                    
                    if cert:
                        print(f"[+] Certificate: {cert.get('subject', 'Unknown')}")
                        
        except Exception as e:
            print(f"[-] SSL analysis failed: {e}")
    
    def analyze_headers(self):
        """Analyze security headers"""
        print("[*] Analyzing security headers...")
        
        try:
            resp = self.session.get(self.target_url, headers=self.get_random_headers(), timeout=self.timeout)
            headers = resp.headers
            
            security_headers = {
                'X-Frame-Options': 'Clickjacking protection',
                'X-Content-Type-Options': 'MIME sniffing protection',
                'X-XSS-Protection': 'XSS protection',
                'Content-Security-Policy': 'CSP protection',
                'Strict-Transport-Security': 'HSTS',
                'Referrer-Policy': 'Referrer policy',
                'Permissions-Policy': 'Feature policy',
                'Cache-Control': 'Cache control'
            }
            
            print("\n[*] Security Headers:")
            for header, description in security_headers.items():
                value = headers.get(header, 'Not Set')
                status = '✅' if value != 'Not Set' else '❌'
                print(f"  {status} {header}: {value} ({description})")
                self.results['headers'][header] = value
                
        except Exception as e:
            print(f"[-] Header analysis failed: {e}")
    
    def analyze_cookies(self):
        """Analyze cookies"""
        print("[*] Analyzing cookies...")
        
        try:
            resp = self.session.get(self.target_url, headers=self.get_random_headers(), timeout=self.timeout)
            cookies = resp.cookies
            
            if not cookies:
                print("[+] No cookies found")
                return
            
            print("\n[*] Cookie Analysis:")
            for cookie in cookies:
                secure = '✅' if cookie.secure else '❌'
                httponly = '✅' if cookie.has_nonstandard_attr('HttpOnly') else '❌'
                
                cookie_info = {
                    'name': cookie.name,
                    'secure': cookie.secure,
                    'httponly': cookie.has_nonstandard_attr('HttpOnly'),
                    'domain': cookie.domain,
                    'path': cookie.path
                }
                self.results['cookies'].append(cookie_info)
                
                print(f"  {cookie.name}:")
                print(f"    Secure: {secure}")
                print(f"    HttpOnly: {httponly}")
                print(f"    Domain: {cookie.domain}")
                print(f"    Path: {cookie.path}")
                
        except Exception as e:
            print(f"[-] Cookie analysis failed: {e}")
    
